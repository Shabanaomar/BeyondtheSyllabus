            <div class="section">
               
               <div class="container">
                  
                  <div class="row">
                     
                     <div class="col-lg-4">
                        
                        <div class="icon-set d-flex align-items-center justify-content-center text-center">
                           
                           <div class="icon-text"><span class="number">300,000</span> <span class="text">Over 300,000 Bulldog alumni have graduated from Fresno State.</span></div>
                           </div>
                        </div>
                     
                     <div class="col-lg-4">
                        
                        <div class="icon-set d-flex align-items-center justify-content-center text-center">
                           
