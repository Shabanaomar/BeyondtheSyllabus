                        	<div class="events">					<div class="news-events-header">						<span style="color: #931023; font-size: 16px; text-transform: uppercase; font-weight: bold;">Coming Up</span><a href="https://calendar.fresnostate.edu" class="more">See All Events</a></div>					<div class="card">						<div class="image-overlay"><a href="https://gobulldogs.evenue.net/list/FB">							<div class="card-img-top" style="background-image: url(https://marcomm.fresnostate.edu/images/homepage/coming-up/homepage-comingup.webp);"></div>							<h3>Fresno State Football</h3>							<div class="card-overlay"></div></a>						</div>					</div> 					<ul class="events-list"><li><div class="date">10/14</div><a href="https://calendar.fresnostate.edu/#event-details/c619652d-1133-4e26-b022-fb1d480e6638/instances/2026-10-14T18:00">Wellness Wednesday and the Fresh Fruit Break</a></li><li><div class="date">10/14</div><a href="https://calendar.fresnostate.edu/#event-details/05f79156-8152-4d5c-97d7-177d66138fd3">Admitted Students: Next Steps Webinar</a></li><li><div class="date">10/16</div><a href="https://calendar.fresnostate.edu/#event-details/11b3b3f5-f8ee-4273-b983-4b71b156b5e4">Cineculture Screening: Child of Dust (2025)</a></li><li><div class="date">10/17</div><a href="https://calendar.fresnostate.edu/#event-details/6a02aa22-3d26-4704-b157-410fee7458db">Fresno Writers Summit 2026</a></li><li><div class="date">10/19</div><a href="https://calendar.fresnostate.edu/#event-details/4c63dcc4-b57c-421c-9eda-118cc1c36684">Free Flu Shot Clinics</a></li>					</ul>				</div> 
