               <div class="row">
                  <div class="col-lg-12 mb-5">
                     <h1>
                        
                        	
                        <div class="row justify-content-center text-center section-intro">
                           		
                           <div class="col-12 col-md-9 col-lg-8">			
                              			
                              <h1 class="display-4">Clubs and Organizations</h1>
                              			
                              <p class="lead pb-3 font-weight-light">Student organizations offer an array of experiences and opportunities to build lifelong
                                 relationships at Fresno State</p>
                              		</div>
                           	</div>
                         
                        </h1>
                     
                     <hr>
                     
                     <section>
                        <div class="container">
                           <div class="row">
                              <div class="col">
                                 <h2 class="font-size-xl font-weight-light text-center mt-5 mb-5">
                                    							Start Here!
                                    						</h2>
                              </div>
                           </div>
                           
                           <div class="row">
                              <div class="col-lg-4">
                                 <td data-row="card-1">
                                    
                                    <div class="card  h-100 ">
                                       <div class="image-overlay">
                                          <div class="card-img-top" style="background-image: url('/studentinvolvement/images/clubs/join-marketing-tn.jpg');"></div>
                                          <h3>Join a Club</h3>
                                          <div class="card-overlay"></div>
                                       </div>
                                       <div class="card-body d-flex flex-column">
                                          
                                          <h4>200+ active clubs</h4>
                                          
                                          <ul>
                                             
                                             <li>Develop connections with your peers and make new friends</li>
                                             
                                             <li>Celebrate your identity, values, quirks, and interests with others!</li>
                                             
                                             <li>Fresno State's ENGAGE hosts each club's information and sign-up page</li>
                                             </ul>
                                          
                                          <p>
                                             
                                             	<a href="https://engage.fresnostate.edu/" class="btn btn-default btn-black w-100">Join a Club</a>
                                             
                                             </p>
                                          </div>
                                    </div>
                                    </td>
                              </div>
                              <div class="col-lg-4">
                                 <td data-row="card-1">
                                    
                                    <div class="card  h-100 ">
                                       <div class="image-overlay">
                                          <div class="card-img-top" style="background-image: url('/studentinvolvement/images/clubs/asi-office-tn.jpg');"></div>
                                          <h3>Manage a Club</h3>
                                          <div class="card-overlay"></div>
                                       </div>
                                       <div class="card-body d-flex flex-column">
                                          
                                          <h4>Tools for Success</h4>
                                          
                                          <ul>
                                             
                                             <li>Utilize re-registration tools</li>
                                             
                                             <li>Learn about the different ways to maintain and support your club</li>
                                             
                                             <li>Find information about club finances, fundraising policies and on-campus banking through
                                                ASI</li>
                                             </ul>
                                          
                                          <p>
                                             
                                             	<a href="/studentinvolvement/clubs/manage/index.html" class="btn btn-default btn-black w-100">Manage Your Club</a>
                                             
                                             </p>
                                          </div>
                                    </div>
                                    </td>
                              </div>
                              <div class="col-lg-4">
                                 <td data-row="card-1">
                                    
                                    <div class="card  h-100 ">
                                       <div class="image-overlay">
                                          <div class="card-img-top" style="background-image: url('/studentinvolvement/images/clubs/make-club-tn.jpg');"></div>
                                          <h3>Start a Club</h3>
                                          <div class="card-overlay"></div>
                                       </div>
                                       <div class="card-body d-flex flex-column">
                                          
                                          <h4>Create Your Space</h4>
                                          
                                          <ul>
                                             
                                             <li>Looking for a specific club but can't find it? Start your own!</li>
                                             
                                             <li>Use the resources provided to carve out your own space on-campus</li>
                                             
                                             <li>Build leadership and organization skills by leading your own club</li>
                                             </ul>
                                          
                                          <p>
                                             
                                             	<a href="/studentinvolvement/clubs/start.html" class="btn btn-default btn-black w-100">Start a Club</a>
                                             
                                             </p>
                                          </div>
                                    </div>
                                    </td>
                              </div>
                           </div>
                           </div>
                     </section>
                     
                     <h3>Questions and Support</h3>
                     
                     <p>Please visit the FAQ below and, if you still have questions, please reach out to our
                        team of staff and students. They are ready to assist with the creation and management
                        of student clubs and organizations!</p>
                     
                     <p>
                        
                        	<a href="/studentinvolvement/clubs/manage/club-faq.html" class="btn btn-default btn-black w-100">Frequently Asked Questions</a>
                        
                        </p>
                     
                     <div class="row">
                        <div class="col-sm-4">
                           
                           <div class="card mb-3 card-borderless bg-secondary">
                              <div class="card-body">
                                 <h2 class="card-title h3">Questions and Support</h2>
                                 <p><strong>Club Hub</strong><br>
                                    Resnick Student Union, Room 301<br><span class="far fa-envelope"></span><a href="mailto:clubhub@mail.fresnostate.edu"> clubhub@mail.fresnostate.edu</a><br><span class="fas fa-phone"></span> 559.278.6018					
                                    </p>
                              </div>
                           </div>
                           </div>
                        <div class="col-sm-4">
                           
                           <div class="card mb-3 card-borderless bg-secondary">
                              <div class="card-body">
                                 <h2 class="card-title h3">Events and Communications</h2>
                                 <p><strong>Paige Frese</strong><br>
                                    Graduate Assistant<br><span class="far fa-envelope"></span><a href="mailto:si_studentorgs@mail.fresnostate.edu"> si_studentorgs@mail.fresnostate.edu</a><br><span class="fas fa-phone"></span> 559-278-8932					
                                    </p>
                              </div>
                           </div>
                           </div>
                        <div class="col-sm-4">
                           
                           <div class="card mb-3 card-borderless bg-secondary">
                              <div class="card-body">
                                 <h2 class="card-title h3">Logistics and Policy</h2>
                                 <p><strong>Eddie Dominguez</strong><br>
                                    Coordinator<br><span class="far fa-envelope"></span><a href="mailto:jdominguez@mail.fresnostate.edu"> jdominguez@mail.fresnostate.edu</a><br><span class="fas fa-phone"></span> 559.278.2741					
                                    </p>
                              </div>
                           </div>
                           </div>
                     </div>
                     
                     <p><em>All students, regardless of race, sex, color, ethnicity or national origin, who are
                           interested are welcome to participate in a student club or organization.</em></p>
