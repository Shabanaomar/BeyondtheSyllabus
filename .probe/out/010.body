               <div class="row">
                  <div class="col-lg-12 mb-5">
                     <div class="text-right mb-3"></div>
                     <div class="container">
                        <div class="row justify-content-center text-center ">
                           <div class="col">
                              <div class="text">
                                 <h1 class="font-size-l font-weight-light">Welcome Back BBQ and Industry Expo</h1>
                                 <p class="lead font-weight-light">Wednesday, Sept. 23, 2026 | 10 a.m. to 2 p.m. | Engineering East (South Lawn)</p>
                                 <p class="lead pb-3 font-weight-light">Join the Lyles College of Engineering for its 19th annual Welcome Back BBQ and Industry
                                    Expo! New and returning engineering, construction management and architectural studies
                                    students will have the opportunity to meet representatives from over 90 Valley businesses
                                    who are recruiting for all majors within the Lyles College! Students are encouraged
                                    to bring their resumes to share with companies.</p><a class="btn btn-default" href="https://drive.google.com/drive/folders/1z_pYVL6F3hYz7lqJocaWOUk4k6qo_eT5?usp=sharing">Students: Upload Resumes Here</a><a class="btn btn-default ml-1" href="https://docs.google.com/forms/d/e/1FAIpQLSdFZKsi2kqpY1mYY4nCbzscuUY8HNWUDCOINhrbPTG2fzMGvw/viewform">Companies: Register to Participate Here</a></div>
                           </div>
                        </div>
                     </div>
                     
                     	
                     <ul class="row feature-list feature-list-sm">
                        		
                        <li class="col-12 col-md-6 col-lg-4">
                           			
                           <div class="card card-lg">
                              				
                              <figure>
                                 					<img class="card-img-top figure-img" src="/images/events/eng-bbq1.jpg" alt="Students meet with company representatives" data-action="zoom">
                                 					
                                 <figcaption class="figure-caption text-center">Representatives from over 70 Valley businesses 
                                    </figcaption>
                                 				</figure>
                              			</div>
                           		</li>		
                        <li class="col-12 col-md-6 col-lg-4">
                           			
                           <div class="card card-lg">
                              				
                              <figure>
                                 					<img class="card-img-top figure-img" src="/images/events/eng-bbq2.jpg" alt="Students meet with company representativs" data-action="zoom">
                                 					
                                 <figcaption class="figure-caption text-center">Recruitment opportunities for all Lyles College majors
                                    </figcaption>
                                 				</figure>
                              			</div>
                           		</li>		
                        <li class="col-12 col-md-6 col-lg-4">
                           			
                           <div class="card card-lg">
                              				
                              <figure>
                                 					<img class="card-img-top figure-img" src="/images/events/eng-bbq3.jpg" alt="Students meet with company representatives" data-action="zoom">
                                 					
                                 <figcaption class="figure-caption text-center">A great chance to network</figcaption>
                                 				</figure>
                              			</div>
                           		</li>
                        		
                        	</ul>
                     
                     
                     <hr>
                     
