                                 <div class="card-body">
                                    					
                                    <h2 class="card-title">Clubs &amp; Organizations</h2>
                                    					
                                    <p class="card-text">Explore our mechanical engineering clubs and get involved today</p>
                                    					<a href="/mechanical/student-clubs/index.html" class="btn btn-default">View our clubs</a>
                                    				</div>
