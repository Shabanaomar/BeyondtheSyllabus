                        <div class="row">
                           		
                           <div class="col-lg-6">
                              			
                              <div class="card white">
                                 				<img src="https://engineering.fresnostate.edu/mechanical/images/homepage/solutions-center.JPG" class="card-img-top" alt="Machine in focus with student in background">
                                 				
                                 <div class="card-body">
                                    					
                                    <h2 class="card-title">Solutions Center</h2>
                                    					
                                    <p class="card-text">The Solutions Center partnership brings real-world projects to undergraduate students
                                       in mechanical engineering</p>
                                    					<a href="/mechanical/solutionscentre.html" class="btn btn-default btn-blue">Start a Project</a>
                                    				</div>
                                 			</div>
