</script>
<script>
    (function ($) {
    'use strict';

    function initBackToTop() {
    var $backToTop = $('.cd-top').first();

    if (!$backToTop.length) {
      return;
    }

    var showOffset = 300;
    var fadeOffset = 1200;
    var scrollDuration = 700;
    var ticking = false;

    function updateBackToTop() {
      var scrollTop = window.scrollY || document.documentElement.scrollTop;
      var isVisible = scrollTop > showOffset;
      var isFaded = scrollTop > fadeOffset;

      $backToTop
        .toggleClass('cd-is-visible', isVisible)
        .toggleClass('cd-fade-out', isVisible && isFaded)
        .attr('aria-hidden', String(!isVisible))
        .attr('tabindex', isVisible ? '0' : '-1');

      ticking = false;
    }

    function handleScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateBackToTop);
        ticking = true;
      }
    }

    $(window).on('scroll.catalogBackToTop', handleScroll);

    $backToTop.on('click.catalogBackToTop', function () {
      var reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (reduceMotion) {
        window.scrollTo(0, 0);
      } else {
        $('html, body')
          .stop(true)
          .animate({ scrollTop: 0 }, scrollDuration);
      }
    });

    // Set the correct state when loading or reloading partway down the page.
    updateBackToTop();
    }

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackToTop, {
      once: true
    });
    } else {
    initBackToTop();
    }
    })(jQuery);
