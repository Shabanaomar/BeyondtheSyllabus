# Copy to .env (Python) or web/.env.local (website). Never commit real values.

# Supabase (one project per environment: development, preview, production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. This key bypasses row-level security. Use it only in server code
# (engine, admin jobs, Next.js server routes). Never prefix it with NEXT_PUBLIC_,
# never import it in client components, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server side only)
ANTHROPIC_API_KEY=

# Engine API base URL used by the website and agent. Local development only: on Vercel the
# web -> engine service binding injects it, so never set it in the Vercel dashboard.
ENGINE_URL=http://localhost:8000
